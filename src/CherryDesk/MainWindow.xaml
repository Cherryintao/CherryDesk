<Window x:Class="CherryDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CherryDesk" Width="1040" Height="740" MinWidth="800" MinHeight="560"
        WindowStyle="None" Background="#1F1F1F" Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" /></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="#2B2B2B" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="38" /><RowDefinition /><RowDefinition Height="26" /></Grid.RowDefinitions>
      <Border Background="#181818" BorderBrush="#2B2B2B" BorderThickness="0,0,0,1">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
            <Border Width="20" Height="20" Background="#0078D4" CornerRadius="3"><TextBlock Text="C" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" /></Border>
            <TextBlock Text="CherryDesk" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="设置" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9D9D9D" FontSize="12" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource CaptionButton}" Click="MinimizeWindow" AutomationProperties.Name="最小化"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Data="M 0 5 L 10 5" /></Button>
            <Button Style="{StaticResource CaptionButton}" Click="MaximizeWindow" AutomationProperties.Name="最大化或还原"><Rectangle Width="9" Height="9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" /></Button>
            <Button Style="{StaticResource CloseCaptionButton}" Click="CloseWindow" AutomationProperties.Name="关闭到托盘"><Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" Data="M 0 0 L 10 10 M 10 0 L 0 10" /></Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition /></Grid.ColumnDefinitions>
        <Border Background="#181818" BorderBrush="#2B2B2B" BorderThickness="0,0,1,0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="56" /><RowDefinition /><RowDefinition Height="64" /></Grid.RowDefinitions>
            <TextBlock Text="功能" Foreground="#9D9D9D" FontSize="11" Margin="24,0" VerticalAlignment="Center" />
            <StackPanel Grid.Row="1">
              <RadioButton x:Name="AudioNavigation" Style="{StaticResource NavigationItem}" GroupName="Sections" IsChecked="True" Checked="NavigationChanged" AutomationProperties.Name="音频设备">
                <StackPanel Orientation="Horizontal"><Path Width="20" Height="20" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Data="M 2 8 L 6 8 L 11 4 L 11 18 L 6 14 L 2 14 Z M 15 7 C 19 9 19 13 15 15 M 18 4 C 24 8 24 14 18 18" /><TextBlock Text="音频设备" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="14" /></StackPanel>
              </RadioButton>
              <RadioButton x:Name="PerformanceNavigation" Style="{StaticResource NavigationItem}" GroupName="Sections" Checked="NavigationChanged" AutomationProperties.Name="性能监控">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <Path Width="20" Height="20" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Data="M 2 3 L 2 20 L 22 20 M 5 15 L 10 9 L 15 12 L 21 4" />
                  <TextBlock Grid.Column="1" Text="性能监控" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="14" />
                  <Ellipse x:Name="MonitoringIndicator" Grid.Column="2" Width="6" Height="6" Fill="#616161" VerticalAlignment="Center" />
                </Grid>
              </RadioButton>
              <RadioButton x:Name="ShutdownNavigation" Style="{StaticResource NavigationItem}" GroupName="Sections" Checked="NavigationChanged" AutomationProperties.Name="关机助手">
                <StackPanel Orientation="Horizontal"><Path Width="20" Height="20" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.5" Data="M 12 1 L 12 11 M 7 4 C -1 9 2 22 12 22 C 22 22 25 9 17 4" /><TextBlock Text="关机助手" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="14" /></StackPanel>
              </RadioButton>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="24,0" VerticalAlignment="Center"><TextBlock Text="本地运行" Foreground="#9D9D9D" FontSize="11" /><TextBlock Text="关闭窗口后驻留托盘" Foreground="#6E7681" FontSize="10" Margin="0,5,0,0" /></StackPanel>
          </Grid>
        </Border>
        <Grid Grid.Column="1">
          <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition /></Grid.RowDefinitions>
          <Border BorderBrush="#2B2B2B" BorderThickness="0,0,0,1"><TextBlock x:Name="SectionPath" Text="设置  /  音频设备" Foreground="#9D9D9D" FontSize="12" Margin="28,0" VerticalAlignment="Center" /></Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="850" HorizontalAlignment="Stretch" Margin="36,28,36,30">
              <StackPanel x:Name="AudioPage">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="音频设备" FontSize="25" Foreground="#FFFFFF" FontWeight="SemiBold" /><TextBlock Text="管理系统默认播放与录音设备。" Foreground="#9D9D9D" Margin="0,9,0,0" /></StackPanel>
                  <Button Grid.Column="1" Content="刷新设备" Style="{StaticResource SecondaryButton}" Click="ManualRefresh" VerticalAlignment="Top" Margin="14,3,0,0" />
                </Grid>
                <StackPanel Margin="0,32,0,0">
                  <TextBlock Text="声音输出" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="选择用于游戏、音乐和系统声音的设备。" Foreground="#9D9D9D" Margin="0,7,0,12" />
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ComboBox x:Name="OutputDevices" DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="声音输出设备" SelectionChanged="SelectionChanged" />
                    <Button x:Name="ApplyOutput" Grid.Column="1" Content="切换输出" Margin="10,0,0,0" Click="SwitchOutput" />
                  </Grid>
                  <TextBlock x:Name="OutputCurrent" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" />
                  <TextBlock x:Name="OutputCommunication" Foreground="#9D9D9D" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Border Height="1" Background="#2B2B2B" Margin="0,25" />
                <TextBlock Text="麦克风输入" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="选择用于语音聊天和录音的输入设备。" Foreground="#9D9D9D" Margin="0,7,0,12" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <ComboBox x:Name="InputDevices" DisplayMemberPath="Name" SelectedValuePath="Id" AutomationProperties.Name="麦克风输入设备" SelectionChanged="SelectionChanged" />
                  <Button x:Name="ApplyInput" Grid.Column="1" Content="切换输入" Margin="10,0,0,0" Click="SwitchInput" />
                </Grid>
                <TextBlock x:Name="InputCurrent" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" />
                <TextBlock x:Name="InputCommunication" Foreground="#9D9D9D" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" />
                <Border Height="1" Background="#2B2B2B" Margin="0,25" />
                <CheckBox x:Name="SyncCommunications" IsChecked="True" Content="切换时同步更新默认通信设备" />
                <TextBlock Text="让语音聊天与普通声音使用同一组默认设备。" Foreground="#9D9D9D" Margin="26,7,0,0" FontSize="12" />
                <TextBlock Text="游戏或语音软件需选择“系统默认设备”，才能跟随系统切换。" Foreground="#9D9D9D" Margin="0,27,0,0" FontSize="12" TextWrapping="Wrap" />
                <TextBlock x:Name="LastRefresh" Foreground="#6E7681" FontSize="11" Margin="0,10,0,0" />
              </StackPanel>
              <StackPanel x:Name="PerformancePage" Visibility="Collapsed">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="性能监控" FontSize="25" Foreground="White" FontWeight="SemiBold" />
                  <CheckBox x:Name="MonitoringEnabled" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Content="启用监控" VerticalAlignment="Center" Checked="MonitoringEnabledChanged" Unchecked="MonitoringEnabledChanged" />
                </Grid>
                <TextBlock Text="关闭此功能后停止所有性能采集，不再占用采样资源。" Foreground="#9D9D9D" Margin="0,9,0,26" TextWrapping="Wrap" />
                <Border x:Name="MonitoringDisabledPanel" Background="#252526" BorderBrush="#2B2B2B" BorderThickness="1" Padding="22" CornerRadius="3">
                  <StackPanel><TextBlock Text="性能监控已关闭" Foreground="White" FontSize="15" /><TextBlock x:Name="DisabledNote" Text="启用后查看 CPU、GPU 和内存占用。" Foreground="#9D9D9D" Margin="0,9,0,0" TextWrapping="Wrap" /></StackPanel>
                </Border>
                <StackPanel x:Name="LivePanel" Visibility="Collapsed">
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="CPU" Foreground="#9D9D9D" /><TextBlock x:Name="LiveCpu" Text="--" Foreground="White" FontFamily="Consolas" FontSize="30" Margin="0,9,0,0" /></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="GPU" Foreground="#9D9D9D" /><TextBlock x:Name="LiveGpu" Text="--" Foreground="White" FontFamily="Consolas" FontSize="30" Margin="0,9,0,0" /></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="物理内存" Foreground="#9D9D9D" /><TextBlock x:Name="LiveMemory" Text="--" Foreground="White" FontFamily="Consolas" FontSize="30" Margin="0,9,0,0" /></StackPanel>
                  </Grid>
                  <TextBlock x:Name="LiveMemoryDetail" Text="正在采样…" Foreground="#9D9D9D" FontSize="12" Margin="0,14,0,0" />
                </StackPanel>
                <TextBlock x:Name="PerformanceNote" Foreground="#9D9D9D" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="19" />
                <Border Height="1" Background="#2B2B2B" Margin="0,24" />
                <StackPanel x:Name="PerformanceSettingsPanel">
                  <TextBlock Text="监控设备" Foreground="White" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="自动选择优先使用独立显卡，也可指定需要查看的 GPU。" Foreground="#9D9D9D" Margin="0,7,0,12" TextWrapping="Wrap" />
                  <ComboBox x:Name="GpuDevices" DisplayMemberPath="Name" SelectedValuePath="Key" SelectionChanged="GpuSelectionChanged" AutomationProperties.Name="监控显卡" />
                  <Border Height="1" Background="#2B2B2B" Margin="0,24" />
                  <TextBlock Text="游戏悬浮窗" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16" />
                  <CheckBox x:Name="ShowOverlay" Content="显示悬浮窗" Checked="OverlayVisibilityChanged" Unchecked="OverlayVisibilityChanged" />
                  <TextBlock Text="临时隐藏时仍继续采集；停止采集请关闭页面顶部的总开关。" Foreground="#9D9D9D" FontSize="12" Margin="26,7,0,14" TextWrapping="Wrap" />
                  <CheckBox x:Name="LockOverlay" Content="锁定位置并穿透鼠标" Checked="OverlayLockChanged" Unchecked="OverlayLockChanged" />
                  <Grid Margin="0,19,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="不透明度" VerticalAlignment="Center" /><Slider x:Name="OverlayOpacity" Grid.Column="1" Minimum="35" Maximum="100" Value="90" Margin="20,0" VerticalAlignment="Center" ValueChanged="OpacityChanged" AutomationProperties.Name="悬浮窗不透明度" /><TextBlock x:Name="OpacityValue" Grid.Column="2" Width="40" Text="90%" VerticalAlignment="Center" />
                  </Grid>
                  <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Ctrl + Shift + F10    显示 / 隐藏" Foreground="#9D9D9D" FontSize="12" /><TextBlock Text="Ctrl + Shift + F11    锁定 / 解锁" Foreground="#9D9D9D" FontSize="12" Margin="0,6,0,0" /></StackPanel>
                    <Button Grid.Column="1" Content="重置位置" Style="{StaticResource SecondaryButton}" Click="ResetOverlayPosition" VerticalAlignment="Center" />
                  </Grid>
                </StackPanel>
              </StackPanel>
              <StackPanel x:Name="ShutdownPage" Visibility="Collapsed">
                <TextBlock Text="关机助手" FontSize="25" Foreground="White" FontWeight="SemiBold" />
                <TextBlock Text="先暂停加速器时长，再安心关机。" Foreground="#9D9D9D" Margin="0,9,0,32" />
                <Border Background="#252526" BorderBrush="#2B2B2B" BorderThickness="1" CornerRadius="3" Padding="24">
                  <StackPanel><TextBlock Text="等待适配外星仔加速器" Foreground="White" FontSize="16" /><TextBlock Text="回家后检查客户端的暂停操作，并验证停止计时的状态。&#x0a;适配完成前，这里不会执行关机。" Foreground="#9D9D9D" LineHeight="23" TextWrapping="Wrap" Margin="0,12,0,0" /></StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </Grid>
      </Grid>
      <Border Grid.Row="2" Background="#181818" BorderBrush="#2B2B2B" BorderThickness="0,1,0,0">
        <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="StatusText" Text="就绪" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1" Text="v0.3.0" Foreground="#9D9D9D" FontSize="11" VerticalAlignment="Center" Margin="16,0,0,0" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
