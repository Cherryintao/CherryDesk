<Window x:Class="CherryDesk.Performance.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CherryDesk 性能悬浮窗" Width="108" Height="74"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="#CCCCCC" UseLayoutRounding="True">
  <Border x:Name="Panel" CornerRadius="4" Background="#F2181818" BorderBrush="#454545" BorderThickness="1" Padding="8,6"
          MouseLeftButtonDown="DragPanel">
    <Grid>
    <Grid x:Name="CompactPanel" Height="60">
      <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="CompactTemperatureColumn" Width="0" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
      <TextBlock Text="CPU" FontSize="11" Foreground="#9D9D9D" VerticalAlignment="Center" />
      <TextBlock x:Name="CompactCpu" Grid.Column="1" Text="--" FontFamily="Consolas" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
      <TextBlock x:Name="CompactCpuTemperature" Grid.Column="2" FontFamily="Consolas" FontSize="13" Foreground="#9D9D9D" HorizontalAlignment="Right" VerticalAlignment="Center" />
      <TextBlock Grid.Row="1" Text="GPU" FontSize="11" Foreground="#9D9D9D" VerticalAlignment="Center" />
      <TextBlock x:Name="CompactGpu" Grid.Row="1" Grid.Column="1" Text="--" FontFamily="Consolas" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
      <TextBlock x:Name="CompactGpuTemperature" Grid.Row="1" Grid.Column="2" FontFamily="Consolas" FontSize="13" Foreground="#9D9D9D" HorizontalAlignment="Right" VerticalAlignment="Center" />
      <TextBlock Grid.Row="2" Text="内存" FontSize="11" Foreground="#9D9D9D" VerticalAlignment="Center" />
      <TextBlock x:Name="CompactMemory" Grid.Row="2" Grid.Column="1" Text="--" FontFamily="Consolas" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
    </Grid>
    <StackPanel x:Name="FullPanel" Visibility="Collapsed">
      <Grid Margin="0,0,0,12">
        <TextBlock Text="性能监控" FontSize="13" FontWeight="SemiBold" />
        <TextBlock x:Name="ModeText" Text="已锁定 · 鼠标穿透" HorizontalAlignment="Right" FontSize="10" Foreground="#9D9D9D" VerticalAlignment="Center" />
      </Grid>
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition /><ColumnDefinition Width="54" /><ColumnDefinition Width="59" /></Grid.ColumnDefinitions>
        <TextBlock Text="CPU" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
        <ProgressBar x:Name="CpuBar" Grid.Column="1" Height="4" Foreground="#0078D4" Background="#313131" BorderThickness="0" Maximum="100" />
        <TextBlock x:Name="CpuText" Grid.Column="2" Text="--" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="21" />
        <TextBlock x:Name="CpuTemperatureText" Grid.Column="3" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" FontSize="14" Foreground="#9D9D9D" />
      </Grid>
      <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition /><ColumnDefinition Width="54" /><ColumnDefinition Width="59" /></Grid.ColumnDefinitions>
        <TextBlock Text="GPU" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
        <ProgressBar x:Name="GpuBar" Grid.Column="1" Height="4" Foreground="#4DAAFC" Background="#313131" BorderThickness="0" Maximum="100" />
        <TextBlock x:Name="GpuText" Grid.Column="2" Text="--" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="21" />
        <TextBlock x:Name="GpuTemperatureText" Grid.Column="3" Text="--" HorizontalAlignment="Right" VerticalAlignment="Center" FontFamily="Consolas" FontSize="14" Foreground="#9D9D9D" />
      </Grid>
      <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition /><ColumnDefinition Width="54" /><ColumnDefinition Width="59" /></Grid.ColumnDefinitions>
        <TextBlock Text="内存" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
        <ProgressBar x:Name="MemoryBar" Grid.Column="1" Height="4" Foreground="#B180D7" Background="#313131" BorderThickness="0" Maximum="100" />
        <TextBlock x:Name="MemoryText" Grid.Column="2" Text="--" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="21" />
      </Grid>
      <TextBlock x:Name="MemoryDetail" Text="物理内存 · 采样中" Foreground="#9D9D9D" FontSize="10" Margin="0,9,0,0" />
      <TextBlock x:Name="CpuName" Text="CPU · 正在识别…" Foreground="#9D9D9D" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
      <TextBlock x:Name="GpuName" Text="正在识别显卡…" Foreground="#9D9D9D" FontSize="10" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
      <TextBlock Text="温度 -- 表示当前未读到传感器数据" Foreground="#6E7681" FontSize="10" Margin="0,7,0,0" />
    </StackPanel>
    </Grid>
  </Border>
</Window>
